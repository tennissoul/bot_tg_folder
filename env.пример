# Telegram Bot Token (обязательно)
BOT_TOKEN=

# CryptoPay API Token (опционально; без него оплата отключена)
CRYPTOPAY_TOKEN=

# Обязательный HTTPS webhook URL при настроенном CRYPTOPAY_TOKEN
CRYPTOPAY_WEBHOOK_URL=https://example.com/webhooks/cryptopay

# Адрес локального Kestrel; HTTPS завершается на reverse proxy
CRYPTOPAY_WEBHOOK_LISTEN_URL=http://127.0.0.1:8081

# Разрешить тестовую выдачу ключа только без настроенного CryptoPay (только для разработки)
ALLOW_TEST_PAYMENTS=false

# OpenRouter API Key для AI (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Telegram User IDs администраторов (через запятую)
ADMIN_IDS=123456789

# Настройки поддержки
SUPPORT_USERNAME=Admin
TERMS_URL=

# Путь к файлу базы данных
DATA_PATH=data/bot_data.json
